# Copy to .env and adjust. scripts/up.ps1 does this automatically on first run.
#
# Connection URLs below are host-side (localhost) for running code outside Docker.
# docker-compose.yml overrides them with in-network addresses (kafka:29092, postgres:5432,
# mlflow:5000) for the app containers, so they only matter for local development.

# ---- General ----
COMPOSE_PROJECT_NAME=traffic-intel
APP_ENV=development
LOG_LEVEL=INFO

# ---- Host ports ----
# Each maps a host port to a fixed container port. Change one if it clashes with
# something already running on your machine, then re-run scripts/up.ps1.
# api listens on 8000 inside the Docker network; API_PORT is only the host-side port.
API_PORT=8001
DASHBOARD_PORT=5173
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
POSTGRES_PORT=5432
MLFLOW_PORT=5000
ADMINER_PORT=8081

# ---- Dashboard ----
# Defaults to http://localhost:${API_PORT}. Set only if the API is reached some other way.
# VITE_API_BASE_URL=http://localhost:8001

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:${KAFKA_PORT}

# ---- PostgreSQL (dev credentials; change for anything shared) ----
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
# Created alongside POSTGRES_DB on first start; changing it later requires deleting the postgres_data volume.
MLFLOW_DB=mlflow
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:${MLFLOW_PORT}

# ---- Video ingest ----
# Cameras and their stream_url come from the cameras table (see scripts/download_sample_videos.py).
# 5 fps keeps vehicles overlapping between frames so ByteTrack can follow them (2 fps loses tracks).
FRAME_SAMPLE_FPS=5
FRAME_MAX_WIDTH=1280
FRAME_JPEG_QUALITY=85
FRAME_RETENTION_MINUTES=10
FRAME_CLEANUP_INTERVAL_SECONDS=60
METRICS_LOG_INTERVAL_SECONDS=30
CAMERA_REFRESH_SECONDS=60
SOURCE_RETRY_INITIAL_SECONDS=2
SOURCE_RETRY_MAX_SECONDS=60
SOURCE_TIMEOUT_SECONDS=10

# ---- Event simulator ----
# Mean gap between background text reports, across all cameras.
REPORT_INTERVAL_SECONDS=10
# Weather + loop-detector events per camera.
SENSOR_INTERVAL_SECONDS=15
# Start a random scenario every N minutes; 0 = off. SCENARIO_TIME_SCALE speeds those runs up.
SCENARIO_SCHEDULE_MINUTES=0
SCENARIO_TIME_SCALE=1
SIMULATOR_TIMEZONE=Europe/London
# ---- CV inference ----
# YOLO weights used to bootstrap the MLflow registry (vehicle-detector@champion) on first start.
CV_MODEL=yolo26n.pt
CV_IMGSZ=480
CV_CONFIDENCE=0.35
# openvino (default) | pytorch | auto (whichever benchmarks faster at startup)
CV_BACKEND=openvino
# Inference threads; empty = half the cores, at most 6 (more is slower inside the Docker VM).
CV_THREADS=
CV_MAX_FRAME_AGE_SECONDS=5
CV_METRICS_WINDOW_SECONDS=5
CV_STOPPED_SPEED_KMH=3
CV_STOPPED_AFTER_SECONDS=5
CV_STATS_INTERVAL_SECONDS=30
# ---- Anomaly service ----
# Champion models come from the MLflow registry (re-checked every MODEL_REFRESH_SECONDS);
# without them the service uses rule-based detectors and logs that at startup.
ANOMALY_SCORE_INTERVAL_SECONDS=5
# An alarm needs this many consecutive checks above threshold; it ends after
# ANOMALY_CLEAR_AFTER checks below ANOMALY_CLEAR_RATIO x threshold, then cools down.
ANOMALY_MIN_CONSECUTIVE=2
ANOMALY_CLEAR_RATIO=0.8
ANOMALY_CLEAR_AFTER=3
ANOMALY_COOLDOWN_SECONDS=120
MODEL_REFRESH_SECONDS=300
# Hold rule (an alert stays open while speeds stay below RATIO x the baseline frozen at its
# start, or stopped vehicles exceed it by more than MARGIN), severity bounds (score/threshold
# for medium,high,critical) and how often escalation updates may be published.
ANOMALY_HOLD_SPEED_RATIO=0.6
ANOMALY_HOLD_STOPPED_MARGIN=1
ANOMALY_MAX_HOLD_SECONDS=1800
ANOMALY_SEVERITY_BOUNDS=2,4,8
ANOMALY_UPDATE_MIN_SECONDS=15
# System-wide degradation: this many cameras with frames below FRAMES_RATIO x baseline or
# detection confidence below CONFIDENCE_RATIO x baseline in the same check -> one system-scoped
# camera_degraded anomaly, per-camera alerts suppressed; per-camera alerts that started up to
# LOOKBACK seconds before it are closed when it clears.
ANOMALY_SYSTEM_MIN_CAMERAS=3
ANOMALY_SYSTEM_FRAMES_RATIO=0.85
ANOMALY_SYSTEM_CONFIDENCE_RATIO=0.9
ANOMALY_SYSTEM_LOOKBACK_SECONDS=60
# nlp_service: classifier champion from MLflow (keyword fallback until one is registered),
# reports classified together when several are waiting (up to NLP_MAX_BATCH), pretrained NER
# for locations (downloaded once into the hf_cache volume), and fuzzy camera matching (an
# alias must score NLP_MATCH_MIN_SCORE; the camera is returned at NLP_MATCH_MIN_CONFIDENCE).
NLP_MODEL_NAME=incident-text-classifier
NLP_MAX_BATCH=32
NLP_NER_ENABLED=true
NER_MODEL=dslim/bert-base-NER
NLP_MATCH_MIN_SCORE=0.85
NLP_MATCH_MIN_CONFIDENCE=0.7
# fusion_service (every FusionConfig field can be set as FUSION_<NAME>; the main ones):
# correlation window, the text burst that creates an incident on its own, confirmation and
# resolution rules, and the fused-confidence weights (strongest modality, the other one,
# their agreement).
FUSION_WINDOW_SECONDS=600
FUSION_TEXT_BURST_SECONDS=180
FUSION_MIN_TEXT_REPORTS=4
FUSION_MIN_TEXT_SOURCES=2
FUSION_CONFIRM_MIN_AGREEMENT=0.5
FUSION_STRONG_SINGLE=0.9
FUSION_QUIET_SECONDS=300
FUSION_CLEAR_MIN_SECONDS=20
FUSION_WEIGHT_PRIMARY=0.6
FUSION_WEIGHT_SECONDARY=0.25
FUSION_WEIGHT_AGREEMENT=0.15
FUSION_PUBLISH_CONFIDENCE_DELTA=0.1
# summarizer: champion configuration from MLflow ("incident-summarizer"; until one is
# registered, SUMMARY_DEFAULT_MODEL with prompt SUMMARY_DEFAULT_PROMPT), updates to one incident
# within SUMMARY_DEBOUNCE_SECONDS are summarised once, and generation over
# SUMMARY_TIMEOUT_SECONDS falls back to the template.
SUMMARIZER_MODEL_NAME=incident-summarizer
SUMMARY_DEBOUNCE_SECONDS=10
SUMMARY_TIMEOUT_SECONDS=20
SUMMARY_DEFAULT_MODEL=google/flan-t5-base
SUMMARY_DEFAULT_PROMPT=v1
# ---- Models (placeholder) ----
MODELS_DIR=/models
